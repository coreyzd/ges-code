// Linux/SDK2013 fallback: the original uses the Windows-only Shader Editor ("editor_shader").
"UnlitGeneric"
{
	"$basetexture" "Goldeneye/Monitors/screen08a"
	"$surfaceprop" "glass"
	"Proxies"
	{
		"TextureScroll"
		{
			"texturescrollvar" "$basetexturetransform"
			"texturescrollrate" 0.03
			"texturescrollangle" 90
		}
	}
}
